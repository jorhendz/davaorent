// PRODUCTION schema — identical to schema.prisma but targeting PostgreSQL
// (Neon / Vercel Postgres / Supabase). Keep the two files in sync when models change.
// Used by: npm run vercel-build, and any command passing --schema=prisma/schema.postgres.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role: RENTER | OWNER | AGENCY | ADMIN
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  phone            String?
  password         String
  name             String
  role             String   @default("RENTER")
  verifiedEmail    Boolean  @default(false)
  verifiedPhone    Boolean  @default(false)
  verifiedIdentity Boolean  @default(false)
  createdAt        DateTime @default(now())

  listings      Listing[]
  favorites     Favorite[]
  inquiries     Inquiry[]        @relation("RenterInquiries")
  messages      Message[]
  viewings      ViewingRequest[] @relation("RenterViewings")
  applications  Application[]
  reviews       Review[]
  reports       Report[]
  notifications Notification[]
  payments      Payment[]
}

// category: APARTMENT | BOARDING_HOUSE | BEDSPACE | ROOM | CONDO | HOUSE | COMMERCIAL | WAREHOUSE | OFFICE
//         | CAR | MOTORCYCLE | EQUIPMENT | EVENT | APPLIANCE | VACATION
// status: DRAFT | SUBMITTED | NEEDS_REVISION | PUBLISHED | REJECTED | ARCHIVED
// availability: AVAILABLE | RESERVED | OCCUPIED
model Listing {
  id                String    @id @default(cuid())
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id])
  title             String
  description       String
  category          String
  price             Int
  priceUnit         String    @default("MONTH")
  deposit           Int       @default(0)
  advance           Int       @default(0)
  district          String
  barangay          String
  addressFull       String
  landmark          String?
  bedrooms          Int       @default(0)
  bathrooms         Int       @default(1)
  floorArea         Int?
  furnished         Boolean   @default(false)
  petFriendly       Boolean   @default(false)
  parking           Boolean   @default(false)
  aircon            Boolean   @default(false)
  internet          Boolean   @default(false)
  utilitiesIncluded Boolean   @default(false)
  minStayMonths     Int       @default(1)
  availableFrom     DateTime?
  amenities         String    @default("[]")
  houseRules        String    @default("[]")
  status            String    @default("DRAFT")
  availability      String    @default("AVAILABLE")
  featured          Boolean   @default(false)
  featuredUntil     DateTime?
  verifiedProperty  Boolean   @default(false)
  views             Int       @default(0)
  adminNote         String?
  publishedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  photos       ListingPhoto[]
  favorites    Favorite[]
  inquiries    Inquiry[]
  viewings     ViewingRequest[]
  applications Application[]
  reviews      Review[]
  reports      Report[]
  payments     Payment[]
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  isCover   Boolean @default(false)
  sort      Int     @default(0)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Inquiry {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId  String
  renter    User      @relation("RenterInquiries", fields: [renterId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([listingId, renterId])
}

model Message {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// status: REQUESTED | CONFIRMED | DECLINED | RESCHEDULED | COMPLETED | CANCELLED | NO_SHOW
model ViewingRequest {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId      String
  renter        User     @relation("RenterViewings", fields: [renterId], references: [id])
  preferredDate DateTime
  virtual       Boolean  @default(false)
  visitors      Int      @default(1)
  note          String?
  status        String   @default("REQUESTED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// status: SUBMITTED | UNDER_REVIEW | INFO_NEEDED | APPROVED | DECLINED | WITHDRAWN
model Application {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId    String
  renter      User     @relation(fields: [renterId], references: [id])
  moveInDate  DateTime
  occupants   Int      @default(1)
  stayMonths  Int      @default(6)
  employment  String?
  incomeRange String?
  pets        String?
  message     String?
  status      String   @default("SUBMITTED")
  ownerNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([listingId, authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// product: FEATURED_7 | FEATURED_15 | FEATURED_30
// status: PENDING | PAID | FAILED | REFUNDED | CANCELLED
model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  product     String
  description String
  amount      Int
  status      String   @default("PAID")
  method      String   @default("SANDBOX")
  reference   String
  createdAt   DateTime @default(now())
}

// status: REPORTED | UNDER_REVIEW | ACTION_TAKEN | RESOLVED | CLOSED
model Report {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  details    String?
  status     String   @default("REPORTED")
  createdAt  DateTime @default(now())
}
