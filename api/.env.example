# Local dev (SQLite). In production use a Postgres URL (Neon / Vercel Postgres)
# together with prisma/schema.postgres.prisma.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4000

# Chat assistant ("Dara"). Without this the widget still works, answering from a
# built-in FAQ; with it, the assistant is Claude-powered and can search live
# listings and the signed-in user's own activity. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY="sk-ant-…"

# Production-only (Vercel):
# CORS_ORIGIN="https://your-web.vercel.app"          # comma-separated allowed origins
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"           # enables photo uploads to Vercel Blob
